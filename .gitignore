# dependencies
node_modules/

# Next.js
/.next

# testing
/coverage
/.e2e

# the Anki card script, built by make -C anki from anki/src
/anki/media/_amgi-loop.js
# the wire format's table for the bridge add-on, built by make -C anki from ui/wire/wire.c
/anki/addon/amgi_bridge/wire_schema.py

# misc
.DS_Store
__pycache__/
*.pyc
*.swp
npm-debug.log*

# Environment variables (GEMINI_API_KEY lives in .env.local)
.env*

# Generated audio, its cache, and decks
*.mp3
*.wav
*.m4a
*.apkg

# ...except the starter deck's, which are source, not generated content.
# They are the one set of clips amgi ships rather than makes, because the
# people they exist for are exactly the people with no key to make them
# with (see server/amgi/starter.c). Rebuilt by
# `amgi starter-audio`.
!anki/starter/media/*.mp3
