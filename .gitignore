# dependencies
node_modules/

# Next.js
/.next

# testing
/coverage
/.e2e

# the Anki card script, built by make -C anki from src/utils and anki/src
/anki/media/_amgi-loop.js

# misc
.DS_Store
__pycache__/
*.pyc
*.swp
npm-debug.log*

# Environment variables (GEMINI_API_KEY lives in .env.local)
.env*

# Generated audio, its cache, and decks
*.mp3
*.wav
*.m4a
plusaudio-audio/
*.apkg

# ...except the starter deck's, which are source, not generated content.
# They are the one set of clips amgi ships rather than makes, because the
# people they exist for are exactly the people with no key to make them
# with (see server/amgi/starter.c). They were recorded by
# scripts/build-starter-audio.js, deleted with the Node generator it ran
# through (git history has it); there is no tool to re-record them now.
!anki/starter/media/*.mp3
