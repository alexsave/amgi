{
  "name": "amgi",
  "private": true,
  "workspaces": [
    "plusaudio"
  ],
  "dependencies": {
    "plusaudio": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^14.0.0",
    "puppeteer-core": "^25.11.0",
    "terser": "5.44.0"
  },
  "scripts": {
    "build": "ui/build.sh",
    "start": "ui/build.sh && node ui/server/serve.mjs",
    "dev": "ui/build.sh && node ui/server/serve.mjs",
    "lint": "eslint",
    "test": "ui/build.sh && node --import ./ui/server/hooks.mjs --experimental-test-module-mocks --test \"src/__tests__/**/*.test.js\" \"plusaudio/test/**/*.test.js\" \"anki/test/**/*.test.js\" \"ui/test/*.test.mjs\" \"test/*.test.mjs\" && \"${ANKI_PYTHON_BIN:-python3}\" -m unittest discover -s anki/addon/amgi_bridge/test -p \"test_*.py\" -v",
    "e2e": "ui/build.sh && ui/tools/e2e.sh"
  }
}
