# Copy to .env.local and fill in from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=<anon key>

# Migration note: this app used to be a Create React App and read these under
# REACT_APP_SUPABASE_URL / REACT_APP_SUPABASE_KEY. next.config.js still falls
# back to those names so existing deployments keep working, but new
# environments should set the NEXT_PUBLIC_* names above.
